{
  "expo": {
    "name": "Sidequest",
    "slug": "sidequest",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "sidequest",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#2774AE"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "edu.ucla.sidequest",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Sidequest uses your location to find nearby Bruins and show your driver's location.",
        "NSLocationAlwaysUsageDescription": "Sidequest uses your location to update your driver during a trip."
        },
      "config": {
        "googleMapsApiKey": "AIzaSyAIXwYnh9j9mfor3yd8Zmx0bI9TKLYRkvI"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2774AE"
      },
      "package": "edu.ucla.sidequest",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "config": {
        "googleMaps": { "apiKey": "AIzaSyAIXwYnh9j9mfor3yd8Zmx0bI9TKLYRkvI"}
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Sidequest needs location to find nearby Bruins and track your ride."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
